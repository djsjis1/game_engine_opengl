#version 330 core
// ============================================================
// 顶点着色器 (Vertex Shader)
// 
// 作用：处理每个顶点，将顶点坐标从模型空间转换到裁剪空间
// 
// layout(location = 0): 指定从VAO中哪个属性位置读取数据
// in vec3 aPos:       输入变量，接收顶点位置数据
//                     在OpenGL中 in = 输入 (从CPU→GPU)
// gl_Position:        内置输出变量，顶点在裁剪空间的最终位置
// ============================================================

layout(location = 0) in vec3 aPos;

void main()
{
    // 直接将顶点位置赋值给gl_Position
    // 因为我们还没有引入任何变换矩阵
    // 三角形顶点的坐标将被直接映射到裁剪空间
    gl_Position = vec4(aPos, 1.0);
}
