#version 330 core
// ============================================================
// 片段着色器 (Fragment Shader)
//
// 作用：处理每个片段（像素），计算最终颜色
//
// out vec4 FragColor: 输出变量，片段的最终颜色 (RGBA)
// vec4(r, g, b, a):   每个分量范围 0.0 ~ 1.0
// ============================================================

out vec4 FragColor;

void main()
{
    // 将所有片段输出为橙色
    // R=1.0, G=0.5, B=0.2 → 暖橙色
    FragColor = vec4(1.0f, 0.5f, 0.2f, 1.0f);
}
